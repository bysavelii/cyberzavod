---
// The galleries page in the field: an author's gallery comes from the API in the browser. At
// build time there are no address parameters, so the markup has the page still opening.
import type { Locale } from "@/shared/i18n/locale.ts";
import { Panel } from "@/shared/ui";
import { GalleryBoard } from "./GalleryBoard.tsx";

interface Props {
  /** Page language. */
  locale: Locale;
}

const { locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const siteUrl = Astro.site.href;
---

<Panel scrollable>
  <div class="article">
    <GalleryBoard client:load locale={locale} siteUrl={siteUrl} />
  </div>
</Panel>

<style>
  .article {
    max-width: 48rem;
  }
</style>
