---
// Build journal of a gallery recording: the recording comes from the API in the browser, and the
// whole journal is one island. While the panel is closed it is not visible: idle time is enough
// for the island.
import type { Locale } from "@/shared/i18n/locale.ts";
import { SharedJournal } from "./SharedJournal.tsx";

interface Props {
  /** Page language: journal labels, captions and messages are in it. */
  locale: Locale;
}

const { locale } = Astro.props;

if (Astro.site === undefined) throw new Error("в astro.config.ts не задан site");

const siteUrl = Astro.site.href;
---

<SharedJournal client:idle locale={locale} siteUrl={siteUrl} />
