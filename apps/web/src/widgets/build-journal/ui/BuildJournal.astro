---
// Build journal on the page of a recording from the project journal: the human's prompts and
// interventions and the floor's messages in one list by time. Each entry is a client:visible
// island with a static body in a slot: while the journal is closed it is not visible and no JS
// loads. Highlighting of the entry the floor has reached and the "show on floor" button appear
// only with JS, when the entry is on screen; without it the same markup remains. Only Astro
// creates islands, so the list is assembled here, while the entry body, header and styles are
// shared with `JournalTimeline`, the journal of a recording from the API. Above the list stands
// what the process caught: the reworks of the recording, and, if the task has other runs, a link to
// their comparison; under it, what the recording cost, if that can be told.
import type { SessionRecord } from "@cyberzavod/core";
import type { Locale } from "@/shared/i18n/locale.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { languageNoteOf } from "@/shared/lib/language-note.ts";
import { ButtonLink, Title } from "@/shared/ui";
import { headerOf, timelineOf } from "../lib/timeline.ts";
import { EntryBody } from "./EntryBody.tsx";
import { JournalEntry } from "./JournalEntry.tsx";
import CostSummary from "./CostSummary.astro";
import ReworkSummary from "./ReworkSummary.astro";
import styles from "./Timeline.module.css";

interface Props {
  /** Full recording: unlike the floor, the journal has the full message texts. */
  recording: SessionRecord;
  /** Page language: journal labels and captions are in it. */
  locale: Locale;
  /** Page comparing the runs of this recording's task; absent if there is nothing to compare. */
  comparisonUrl?: string | undefined;
}

const { recording, locale, comparisonUrl } = Astro.props;
const entries = timelineOf(recording.data.events);
const { language } = recording.data;
const languageNote = languageNoteOf(language, locale);
---

{languageNote !== undefined && <p class={styles.language}>{languageNote}</p>}

{comparisonUrl !== undefined && (
  <p class={styles.comparison}>
    <ButtonLink variant="secondary" href={comparisonUrl}>
      {UI_TEXT.comparison.link[locale]}
    </ButtonLink>
  </p>
)}

<ReworkSummary recording={recording} locale={locale} />

<CostSummary recording={recording} locale={locale} />

<Title as="h3" class={styles.heading}>
  {UI_TEXT.journal.timelineHeading[locale]}
</Title>

{entries.length === 0 ? (
  <p class={styles.empty}>{UI_TEXT.journal.empty[locale]}</p>
) : (
  <ol class={styles.timeline}>
    {entries.map((entry) => {
      const { anchor, clock, route } = headerOf(entry, locale);

      return (
        <li id={anchor}>
          <JournalEntry
            client:visible
            recordingId={recording.id}
            speech={entry.speech}
            locale={locale}
            clock={clock}
            route={route}
          >
            <EntryBody entry={entry} language={language} locale={locale} />
          </JournalEntry>
        </li>
      );
    })}
  </ol>
)}
