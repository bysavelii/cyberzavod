---
// Game screen: the factory floor fills the window, the menu on the left, recordings, guides and
// "about" panels on top. Stats are entered from the recordings panel: a menu tile no longer fits
// at 360px. GitHub sign-in is a menu tile on a wide screen and a button in the recordings panel on
// any.
// The page content, the factory floor with its HUD, sits in the field to the right of the menu.
import BaseLayout from "./BaseLayout.astro";
import { GuideList } from "@/widgets/guide-list";
import { RecordingsByProject } from "@/widgets/recording-list";
import { Sidebar } from "@/widgets/sidebar";
import { AccountLink, SignInFailedNotice } from "@/features/sign-in";
import { publishedGuides } from "@/entities/guide";
import { publishedRecordings, statsUrl } from "@/entities/recording";
import { PANELS } from "@/shared/config/panels.ts";
import { site } from "@/shared/config/site.ts";
import { LOCALE_NAMES, otherLocales, type Locale } from "@/shared/i18n/locale.ts";
import { localizedPath, pathWithoutLocale } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";
import { ButtonLink, Drawer } from "@/shared/ui";

interface Props {
  /** Page language: the interface, panels and meta tags are in it. */
  locale: Locale;
  title?: string;
  description?: string;
  /** Whether the page has a build journal (drawers slot); then it is in the menu. */
  journal?: boolean;
  /** Whether the page has a project card (drawers slot); then it is in the menu. */
  project?: boolean;
  /**
   * The page's main heading, if the content has none: on the home page the HUD names the build with
   * a second-level heading, and the first one is the site. Visible only to screen readers and
   * search engines.
   */
  heading?: string | undefined;
  /** "Not found" page: nginx serves it for any unknown address; search engines do not need it. */
  notFound?: boolean;
}

const {
  locale,
  title,
  description,
  journal = false,
  project = false,
  heading,
  notFound = false,
} = Astro.props;
// The "not found" page has no counterpart in another language by address: the switcher leads to
// the factory floor.
const path = notFound ? "/" : pathWithoutLocale(Astro.url.pathname);
const closeLabel = UI_TEXT.panels.close[locale];
---

<BaseLayout locale={locale} path={path} title={title} description={description} notFound={notFound}>
  <div class="game">
    <Sidebar journal={journal} project={project} locale={locale} path={path}>
      <AccountLink slot="account" client:load locale={locale} layout="tile" />
    </Sidebar>
    <main class="field">
      {heading && <h1 class="visually-hidden">{heading}</h1>}
      <slot />
    </main>
  </div>
  <SignInFailedNotice client:idle locale={locale} />

  <Drawer id={PANELS.records} title={UI_TEXT.panels.records[locale]} closeLabel={closeLabel}>
    <div class="records">
      <div class="other-builds">
        <p>{UI_TEXT.lists.otherBuilds[locale]}</p>
        <div class="links">
          <ButtonLink href={statsUrl(locale)}>{UI_TEXT.pages.statsTitle[locale]}</ButtonLink>
        </div>
        <p>{UI_TEXT.account.ownGallery[locale]}</p>
        <div class="links">
          <AccountLink client:load locale={locale} layout="text" />
        </div>
      </div>
      <RecordingsByProject recordings={publishedRecordings} locale={locale} />
    </div>
  </Drawer>
  <Drawer id={PANELS.guides} title={UI_TEXT.panels.guides[locale]} closeLabel={closeLabel}>
    <GuideList guides={publishedGuides} locale={locale} />
  </Drawer>
  <Drawer id={PANELS.about} title={UI_TEXT.panels.about[locale]} closeLabel={closeLabel}>
    <div class="about">
      {otherLocales(locale).map((other) => (
        <p>
          <a href={localizedPath(other, path)} hreflang={other} lang={other}>
            {LOCALE_NAMES[other]}
          </a>
        </p>
      ))}
      <p>{site.description[locale]}</p>
      <p>{UI_TEXT.about.how[locale]}</p>
      <p>
        <a href={site.repoUrl}>{UI_TEXT.about.code[locale]}</a>
      </p>
      <p>
        {UI_TEXT.about.madeBy[locale]}{" "}
        <a href={site.author.url} rel="author">
          {site.author.name}
        </a>
      </p>
    </div>
  </Drawer>
  <slot name="drawers" />
</BaseLayout>

<style>
  .game {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: var(--gutter);
    height: 100dvh;
    padding: var(--gutter);
  }

  .field {
    display: grid;
    min-height: 0;
  }

  .records {
    display: grid;
    gap: var(--space-l);
  }

  .other-builds {
    display: grid;
    gap: var(--space-s);
  }

  .other-builds p {
    margin: 0;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .about p {
    margin: 0 0 var(--space-l);
  }

  @media (width <= 48rem) and (height > 40rem) {
    .game {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
  }
</style>
