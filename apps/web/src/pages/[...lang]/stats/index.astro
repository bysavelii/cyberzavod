---
import type { GetStaticPaths } from "astro";
import GameLayout from "@/app/layouts/GameLayout.astro";
import { BuildStats } from "@/widgets/build-stats";
import { publishedRecordings } from "@/entities/recording";
import { LOCALES, type Locale } from "@/shared/i18n/locale.ts";
import { localeParam } from "@/shared/i18n/path.ts";
import { UI_TEXT } from "@/shared/i18n/ui-text.ts";

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({
    params: { lang: localeParam(locale) },
    props: { locale },
  }))) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<GameLayout
  locale={locale}
  title={UI_TEXT.pages.statsTitle[locale]}
  description={UI_TEXT.pages.statsDescription[locale]}
>
  <BuildStats recordings={publishedRecordings} locale={locale} />
</GameLayout>
