{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/capture/claude/raw/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "statusMessage": "Готовлю облачную сессию к make check-web check-api…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-go.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          },
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook turn-start || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook record || true",
            "async": true
          },
          {
            "type": "command",
            "command": "npx -y --prefer-offline --fetch-retries=0 --prefix \"$CLAUDE_PROJECT_DIR\" cyberzavod@0.10.0 hook stop || echo '{\"systemMessage\":\"Cyberzavod: the stop hook failed or could not start (for example, npx without network). Project checks were skipped.\"}'",
            "timeout": 180,
            "statusMessage": "Running project checks…"
          }
        ]
      }
    ]
  }
}
