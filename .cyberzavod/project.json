{
  "schemaVersion": 2,
  "projectId": "cyberzavod",
  "harness": "2.0.0",
  "workflow": "default",
  "journal": ".cyberzavod/journal",
  "agents": {
    "claude": {
      "planning": {
        "provider": "anthropic",
        "model": "default"
      },
      "implementation": {
        "provider": "anthropic",
        "model": "default"
      },
      "review": {
        "provider": "anthropic",
        "model": "default"
      },
      "verification": {
        "provider": "anthropic",
        "model": "default"
      }
    }
  },
  "verification": {
    "commands": [
      "make check-web check-api"
    ],
    "paths": [
      "apps",
      "packages",
      "adapters",
      "harness"
    ]
  },
  "stack": {
    "languages": [
      "javascript"
    ],
    "frameworks": [],
    "packageManager": "pnpm"
  }
}
