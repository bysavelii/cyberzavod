{
  "schemaVersion": 1,
  "projectId": "cyberzavod",
  "harness": "0.10.0",
  "workflow": "default",
  "journal": ".cyberzavod/journal",
  "agents": {
    "planning": {
      "provider": "anthropic",
      "agent": "claude",
      "model": "default"
    },
    "implementation": {
      "provider": "anthropic",
      "agent": "claude",
      "model": "default"
    },
    "review": {
      "provider": "anthropic",
      "agent": "claude",
      "model": "default"
    },
    "verification": {
      "provider": "anthropic",
      "agent": "claude",
      "model": "default"
    }
  },
  "verification": {
    "commands": [
      "make check-web check-api"
    ],
    "paths": [
      "apps",
      "packages",
      "adapters",
      "harness"
    ]
  },
  "stack": {
    "languages": [
      "javascript"
    ],
    "frameworks": [],
    "packageManager": "pnpm"
  }
}
