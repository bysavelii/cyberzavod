{
  "name": "cyberzavod-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cyberzavod": "pnpm --filter cyberzavod build && node packages/cli/dist/cyberzavod.mjs",
    "dev": "pnpm --filter @cyberzavod/web dev",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "format": "prettier --write . && eslint --fix . && prettier --write .",
    "check": "pnpm -r run check",
    "smoke": "node packages/cli/scripts/smoke.ts"
  },
  "devDependencies": {
    "@cyberzavod/viewer": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "cyberzavod": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
